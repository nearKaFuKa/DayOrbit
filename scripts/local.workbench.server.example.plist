<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- DayOrbit 本地服务 macOS 自启示例：把两个 __DAYORBIT_DIR__ 替换为仓库绝对路径，
     保存为 ~/Library/LaunchAgents/local.DayOrbit.server.plist，然后执行
     launchctl load ~/Library/LaunchAgents/local.DayOrbit.server.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.DayOrbit.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__DAYORBIT_DIR__/src/workbench-server.py</string>
        <string>--root</string>
        <string>__DAYORBIT_DIR__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/DayOrbit-server.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/DayOrbit-server.log</string>
</dict>
</plist>
